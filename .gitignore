# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Dependencies and generated output
node_modules/
__pycache__/
*.py[cod]
dist/
build/
coverage/
.cache/
tmp/
temp/

# Built wiki site: regenerated by `python -m gamewiki.wiki`, published via a
# dedicated gh-pages branch. Committing it to main would duplicate ~70 MB of
# binary media in history on every rebuild.
dist-wiki/

# Session state stays local; curated project notes under memory/ are shared so
# work can continue across machines.
.workbuddy/*
!.workbuddy/memory/

# Local data and databases
data/local/
*.db
*.sqlite
*.sqlite3

# Local content library: game guides and source material stay out of Git
library/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
